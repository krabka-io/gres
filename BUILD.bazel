"""Stable aliases for the Gres PostgreSQL engine surface."""

package(default_visibility = ["//visibility:public"])

exports_files([
    ".cargo/mutants.toml",
    "Cargo.lock",
    "Cargo.toml",
])

alias(
    name = "pgexec",
    actual = "//crates/pgexec",
)

alias(
    name = "pgwire",
    actual = "//crates/pgwire",
)

alias(
    name = "conformance",
    actual = "//crates/gres-conformance",
)
