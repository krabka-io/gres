"""Stable aliases for the Gres PostgreSQL engine surface."""

package(default_visibility = ["//visibility:public"])

exports_files([
    ".cargo/mutants.toml",
    "Cargo.lock",
    "Cargo.toml",
])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

alias(
    name = "pgexec",
    actual = "//crates/pgexec",
)

alias(
    name = "pgwire",
    actual = "//crates/pgwire",
)

alias(
    name = "conformance",
    actual = "//crates/gres-conformance",
)
