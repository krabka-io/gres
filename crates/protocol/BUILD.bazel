load("//bazel:defs.bzl", "crate_library")

exports_files(["Cargo.toml"])

# build.rs validates checked-in generated sources and emits no code. Cargo CI
# runs that validation; Bazel compiles the checked-in codecs directly.
crate_library(
    name = "protocol",
    compile_data = glob([
        "generated/**",
        "schemas/**",
    ]),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "$${pwd}/crates/protocol",
    },
)
