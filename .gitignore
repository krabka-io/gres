target/
**/*.rs.bk

# `/.cargo/config.toml` is TRACKED, and was ignored here until 2026-08-13. It
# holds the git-fetch setting that thirteen workflow files used to repeat. Do
# not ignore it again. An ignored config file never reaches the runners, so
# the setting stops working with nothing to show for it.

# Bazel convenience symlinks + local user settings
/bazel-*
user.bazelrc
.idea/
.vscode/
*.iml
.DS_Store

# Gradle / Java build output
**/.gradle/
**/build/
*.class

# melange / apko build artifacts
.melange-cache/
melange.rsa
melange.rsa.pub
packages/
sbom-*.spdx.json
.tmp-*.log
.worktree
.worktrees/
.superpowers/

# Cargo mutant output
mutants.out
mutants.out.old

# Default output paths of the gres conformance runner, written into the cwd
# when --out/--summary are not given.
/parity.json
/parity.md
/regress-parity.json
/regress-parity.md

# Python bytecode from local runs of scripts/tests
__pycache__/
