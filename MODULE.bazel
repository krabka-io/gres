"""Gres Bazel module.

Bazel is the build and test path for the PostgreSQL engine crates. Cargo stays
the dependency source of truth: rules_rs reads this repository's Cargo.toml
and Cargo.lock instead of maintaining a second dependency graph.
"""

module(
    name = "gres",
    version = "0.4.2",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rs", version = "0.0.112")
bazel_dep(name = "rules_rs_mutants", version = "0.1.1")
bazel_dep(name = "rules_shell", version = "0.8.0")

single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules-rs-target-has-atomic.patch",
    ],
    version = "0.0.112",
)

git_override(
    module_name = "rules_rs_mutants",
    commit = "63bb99ca9a7cb81eab1728bc5d2c9985f23c8560",
    remote = "https://github.com/robot-head/rules_rs_mutants",
)

bazel_dep(name = "llvm", version = "0.8.24")

# Keep llvm-profdata on the same LLVM major as rustc (`rustc -vV`), so coverage
# can merge the raw profiles. Rust 1.99 uses LLVM 23.
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "23.1.2")
use_repo(llvm, "llvm-project")

register_toolchains("@llvm//toolchain:all")

bazel_dep(name = "aws-lc", version = "5.1.0.bcr.3")
bazel_dep(name = "jemalloc", version = "5.3.0-bcr.alpha.5")
bazel_dep(name = "openssl", version = "3.5.5.bcr.0")
bazel_dep(name = "zstd", version = "1.5.7.bcr.2")

rules_rust_bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    rustfmt_version = "nightly/2026-08-14",
    version = "1.99.0",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

bazel_dep(name = "rules_img", version = "0.3.22")
bazel_dep(name = "rules_apko", version = "1.5.56")

apko_toolchain = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko_toolchain.toolchain(apko_version = "v1.2.40")
use_repo(apko_toolchain, "apko_toolchains")

register_toolchains("@apko_toolchains//:all")

apk = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apk.translate_lock(
    name = "gres_base_lock",
    lock = "//packaging/apko:krabka-gres.lock.json",
)
apk.translate_lock(
    name = "gres_base_arm64_lock",
    lock = "//packaging/apko:krabka-gres.arm64.lock.json",
)
use_repo(apk, "gres_base_arm64_lock", "gres_base_lock")

PLATFORM_TRIPLES = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)
crate.from_cargo(
    name = "mutants",
    cargo_lock = "//tools/mutants:Cargo.lock",
    cargo_toml = "//tools/mutants:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)
# The krabka-* crates come from sibling repositories in the krabka-io
# organization, each a Cargo workspace whose `members` is the glob `crates/*`.
# rules_rs resolves a git crate's directory by matching the crate name against
# the members list, and it skips glob entries, so each member's path is named
# here instead.
SIBLING_MEMBERS = {
    "krabka-audit": "crates/audit",
    "krabka-authz": "crates/authz",
    "krabka-broker": "crates/broker",
    "krabka-client-admin": "crates/client-admin",
    "krabka-client-consumer": "crates/client-consumer",
    "krabka-client-core": "crates/client-core",
    "krabka-client-producer": "crates/client-producer",
    "krabka-compression": "crates/compression",
    "krabka-format": "crates/format",
    "krabka-ids": "crates/ids",
    "krabka-kraft-core": "crates/kraft-core",
    "krabka-log": "crates/log",
    "krabka-logfmt": "crates/logfmt",
    "krabka-macros": "crates/macros",
    "krabka-metadata": "crates/metadata",
    "krabka-object-store": "crates/object-store",
    "krabka-raft": "crates/raft",
    "krabka-records-legacy": "crates/records-legacy",
    "krabka-remote-storage": "crates/remote-storage",
    "krabka-remote-storage-topic": "crates/remote-storage-topic",
    "krabka-schema-registry": "crates/schema-registry",
    "krabka-schema-serde": "crates/schema-serde",
    "krabka-security": "crates/security",
    "krabka-telemetry": "crates/telemetry",
    "krabka-throttle": "crates/throttle",
    "krabka-trace-context": "crates/trace-context",
    "krabka-units": "crates/units",
    "krabka-verified": "crates/verified",
    "krabka-voters": "crates/voters",
}

[
    crate.annotation(
        crate = crate_name,
        strip_prefix = directory,
        workspace_cargo_toml = "Cargo.toml",
    )
    for crate_name, directory in SIBLING_MEMBERS.items()
]

# krabka-protocol's build.rs only checks that its checked-in `generated/`
# sources still match the `schemas/` SHAs; it emits no code. It reads its own
# manifest directory through `env!("CARGO_MANIFEST_DIR")`, which rules_rust
# rejects, so Bazel skips it. The Cargo build in krabka-protocol still runs it.
crate.annotation(
    crate = "krabka-protocol",
    gen_build_script = "off",
    strip_prefix = "crates/protocol",
    workspace_cargo_toml = "Cargo.toml",
)
crate.annotation(
    crate = "cargo-mutants",
    gen_binaries = ["cargo-mutants"],
    repositories = ["mutants"],
)

# sqlx 0.9 gates both sides of Executor::describe on `offline`. Cargo unifies
# that feature across sqlx-core and sqlx-postgres; rules_rs currently carries
# it only to sqlx-core unless it is stated for the driver as well.
crate.annotation(
    crate = "sqlx-postgres",
    crate_features = ["offline"],
)
crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    deps = ["@crates//:aws_lc_sys_build_info"],
)
crate.annotation(
    build_script_data = ["@openssl//:gen_dir"],
    build_script_env = {
        "OPENSSL_DIR": "$(execpath @openssl//:gen_dir)",
        "OPENSSL_NO_VENDOR": "1",
        "OPENSSL_STATIC": "1",
    },
    crate = "openssl-sys",
    data = ["@openssl//:gen_dir"],
    gen_build_script = "on",
)
crate.annotation(
    crate = "tikv-jemalloc-sys",
    gen_build_script = "off",
    deps = ["@jemalloc"],
)
crate.annotation(
    crate = "zstd-sys",
    gen_build_script = "off",
    deps = ["@zstd"],
)
use_repo(crate, "crates", "mutants")

inject_repo(crate, "aws-lc", "openssl")
